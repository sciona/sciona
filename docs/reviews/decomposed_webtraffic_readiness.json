  "source_stages": [
    {
      "stage_id": "log1p_transformation",
      "description": "strictly apply log1p to the Wikipedia page views to suppress massive traffic spikes and stabilize neural network gradients (numpy)"
    },
    {
      "stage_id": "missing_value_masking",
      "description": "tag NaN values with an explicit boolean flag and fill with 0 to inform the network of missing data mechanically (pandas)"
    },
    {
      "stage_id": "seq2seq_architecture",
      "description": "construct an LSTM Encoder-Decoder network. The encoder ingests the trailing 60 days of traffic, passing the hidden state to the decoder which predicts the next 60 days autoregressively (TensorFlow)"
    },
    {
      "stage_id": "exogenous_concatenation",
      "description": "append Wikipedia page metadata (language, domain) to the LSTM inputs at every timestep"
    },
    {
      "stage_id": "smape_optimization",
      "description": "train the entire network natively on a smooth approximation of the SMAPE (Symmetric Mean Absolute Percentage Error) loss function (TensorFlow)"
    }
  ],
