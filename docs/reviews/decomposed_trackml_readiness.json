  "source_version_id": "11c41ece-c648-50b4-b211-7e319ba36dea",
  "source_stages": [
    {
      "stage_id": "detector_geometry_autodiscovery",
      "description": "Discover detector structure from module positions using KMeans (radial rings) and MeanShift (z-layers). Compute layer radii, z-positions, ring gap boundaries, and monotonic z-coverage for O(1) reachability queries."
    },
    {
      "stage_id": "coordinate_rescaling_for_knn",
      "description": "Project hits to mean cylinder radius, scale x,y by zscale to create elliptical neighborhoods matching the detector's natural metric. Separate transforms for cylinder and cap layers."
    },
    {
      "stage_id": "per_layer_knn_search",
      "description": "Build sklearn NearestNeighbors index per detector layer on the rescaled coordinates. Query for k nearest neighbors within radius, returning candidate hit indices and distances."
    },
    {
      "stage_id": "circle_from_three_points",
      "description": "Fit a circumscribed circle through three x-y hit positions. The x,y-projection of a charged particle helix in uniform B-field is a circle. Handles degenerate cases (collinear/coincident) by constructing large tangent circles."
    },
    {
      "stage_id": "helix_pitch_least_squares",
      "description": "Given circle center, z-coordinate is linear in phase angle phi. Linear regression of z vs phi for three points with careful phase-unwrapping. Sum-of-squared-residuals serves as track quality signal."
    },
    {
      "stage_id": "helix_cylinder_intersection",
      "description": "Exploit that r^2 = x^2 + y^2 is a harmonic function of helix phase, so cylinder crossings reduce to solving cos(phi)=C analytically (up to 4 candidates). Pick closest forward-moving solution. Recursive miss-and-retry for lateral misses."
    },
    {
      "stage_id": "helix_cap_intersection",
      "description": "Intersect helix with planar disk detector layers (z=constant). Simpler than cylinder case but includes recursive miss-and-retry for radial gaps between cap module rings."
    },
    {
      "stage_id": "perturbative_helix_correction",
      "description": "Real trajectories deviate from perfect helices due to energy loss, scattering, and B-field inhomogeneity. Apply learned displacement maps (per-layer RegularGridInterpolator) scaled by q/momentum for physics-informed transfer across momenta."
    },
    {
      "stage_id": "helix_nearest_point_distance",
      "description": "Compute nearest point on helix to a reference point. Recognizes this is equivalent to Kepler's equation E - e*sin(E) = M. Solved via Newton's method (3 iterations)."
    },
    {
      "stage_id": "bayesian_neighbor_evaluation",
      "description": "Cut-off derived from Bayesian signal-vs-background likelihood ratio. Dense regions get tighter cuts, sparse regions get looser cuts. Adaptive thresholding based on local hit density."
    },
    {
      "stage_id": "greedy_track_commit",
      "description": "Process tracks in descending quality order. Discard tracks exceeding max_nloss of already-claimed hits. reserve_skipped prevents cascade pollution."
    }
  ],
