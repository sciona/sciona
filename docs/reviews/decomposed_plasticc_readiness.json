  "source_stages": [
    {
      "stage_id": "flux_correction",
      "description": "Correct astronomical flux measurements based on red-shift metadata to account for cosmological distance effects, normalizing flux to rest-frame values using pandas and numpy."
    },
    {
      "stage_id": "time_series_feature_extraction",
      "description": "Extract summary statistics, slopes, peaks, and other descriptive features for every passband using tsfresh and cesium libraries."
    },
    {
      "stage_id": "gaussian_process_interpolation",
      "description": "Fit Gaussian Processes to irregularly sampled light curves to produce smooth interpolated curves, extracting GP hyperparameters (length-scale, amplitude, noise) as additional features."
    },
    {
      "stage_id": "feature_merging",
      "description": "Concatenate raw time series statistics, GP-derived features, and object metadata into a single flat tabular feature matrix using pandas."
    },
    {
      "stage_id": "model_training",
      "description": "Train an ensemble of LightGBM gradient boosted trees and custom MLP neural networks with minority class augmentation to handle severe class imbalance."
    },
    {
      "stage_id": "platt_calibration",
      "description": "Adjust predicted probabilities using Platt Scaling (sigmoid calibration) on held-out predictions to optimize the competition log-loss metric."
    }
  ],
