  "source_stages": [
    {
      "stage_id": "wavelet_denoising",
      "description": "Apply discrete wavelet transform (DWT) using PyWavelets to filter out high-voltage base noise from the raw power line signal. Threshold wavelet coefficients to remove noise while preserving corona discharge events."
    },
    {
      "stage_id": "peak_detection",
      "description": "Locate corona discharge peaks in the denoised signal using scipy.signal.find_peaks with tuned height and distance parameters."
    },
    {
      "stage_id": "peak_feature_extraction",
      "description": "Compute statistical features from detected peaks (height, width, count) plus raw statistical moments (mean, std, skewness, kurtosis) of the denoised signal."
    },
    {
      "stage_id": "signal_to_matrix_transform",
      "description": "Slice the 1D high-frequency signal into a 2D matrix (spectrogram-like) by reshaping into fixed-width segments, creating a representation suitable for 2D pattern recognition."
    },
    {
      "stage_id": "tabular_model",
      "description": "Train a LightGBM classifier on the extracted peak features and statistical moments for binary fault classification."
    },
    {
      "stage_id": "dl_model",
      "description": "Train a 1D CNN + LSTM network on the raw denoised signal for binary fault classification. The CNN extracts local patterns while the LSTM captures temporal dependencies."
    },
    {
      "stage_id": "weighted_blend",
      "description": "Compute a weighted average of LightGBM and neural network fault probabilities to produce the final prediction."
    }
  ],
